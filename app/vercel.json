{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/issue/:symbol?", "destination": "/app.html" },
    { "source": "/mint/:symbol?", "destination": "/app.html" },
    { "source": "/dollars", "destination": "/app.html" },
    { "source": "/admin", "destination": "/app.html" },
    { "source": "/docs/:section", "destination": "/docs.html" },
    { "source": "/reserve", "destination": "/index.html" }
  ],
  "redirects": [
    { "source": "/app", "destination": "/issue", "permanent": true }
  ]
}

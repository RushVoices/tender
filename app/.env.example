# Your own RPC URL (e.g. a free Helius key). Solana's public RPC works but
# refuses the call that lists every dollar, and is heavily rate-limited.
VITE_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# mainnet-beta (default) or devnet
VITE_CLUSTER=mainnet-beta
# Tender program id (defaults to the one in programs/tender/src/lib.rs)
VITE_PROGRAM_ID=Tnd8T8boTCwrKGnbHu836C879kwuJknnbGv4JpVTVPU
